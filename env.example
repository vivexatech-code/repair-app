# Public website origin used for Vercel APIs (invoices, notifications, payment confirm, phone identity, storage)
EXPO_PUBLIC_WEBSITE_API_URL=https://www.repairseries.in

# Firebase client config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Do NOT add notification secrets here. Push APIs use the Firebase ID token.
