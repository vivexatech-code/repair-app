{
  "expo": {
    "name": "Repair Series",
    "slug": "repair-series",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F4"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C45508"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Repair Series uses your location to pre-fill the service address."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C45508"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.repairseries.user"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Repair Series",
      "shortName": "Repair Series",
      "lang": "en",
      "themeColor": "#C45508",
      "backgroundColor": "#E8E4DF",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "9d18a266-c528-4700-b073-5302073dc057"
      }
    }
  }
}
